<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; justify-content: center; position: absolute; right: auto; left: 0; bottom: 0; width: 194px; height: 156px;">
        <ui:Button text="Profile" name="profile" style="height: 100%; width: 100%; font-size: 36px;" />
    </ui:VisualElement>
    <ui:VisualElement name="profileview" style="flex-grow: 1; justify-content: center; position: absolute; right: 0; left: 0; bottom: 0; width: 100%; height: 100%; top: 0; align-self: center; align-items: center; background-color: rgb(226, 226, 226); display: none;">
        <ui:Button text="Back" name="back" style="height: 80px; width: 190px; font-size: 36px; background-color: rgb(168, 168, 168); color: rgb(0, 0, 0); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; position: absolute; top: 0; left: 0; right: auto; bottom: auto;" />
        <ui:Button text="Edit Character" name="characteredit" style="height: 100px; width: 80%; font-size: 36px; background-color: rgb(1, 97, 233); color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;" />
        <ui:Button text="Reach Out" name="reachout" style="height: 100px; width: 80%; font-size: 36px; top: 10px; background-color: rgb(2, 97, 234); color: rgb(255, 255, 255); border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; border-top-right-radius: 10px; border-top-left-radius: 10px;" />
    </ui:VisualElement>
</ui:UXML>
