.avatar-creation {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: white;
    overflow: hidden;
    color: rgb(177, 89, 38);
    -unity-font-style: bold;
}
.header-wave {
    position: absolute;
    top: 0;
    width: 100%;
    height: 30%;
    background-image: url("project://database/Assets/AttemptUIWithAI/Textures/HeaderWave.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.title {
    position: absolute;
    top: 8%;
    width: 100%;
    height: 9%;
    font-size: 84px;
    -unity-text-align: middle-center;
    color: rgb(177, 89, 38);
}
.decorative-trails {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/AttemptUIWithAI/Textures/DecorativeTrails.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.avatar-preview {
    position: absolute;
    top: 24%;
    left: 19%;
    width: 62%;
    height: 41%;
    background-image: url("project://database/Assets/AttemptUIWithAI/Textures/AvatarPreview.png");
    -unity-background-scale-mode: scale-to-fit;
}
.pill {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 30px;
    background-color: rgb(255, 223, 89);
    color: rgb(177, 89, 38);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.pill:hover { background-color: rgb(255, 232, 135); }
.pill:active { background-color: rgb(255, 190, 60); }
.main-tabs {
    position: absolute;
    top: 56%;
    left: 4.5%;
    right: 4.5%;
    height: 6.7%;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    background-color: rgb(255, 178, 35);
    border-radius: 44px;
}
.main-tab { width: 19%; height: 46%; }
.clothes-tab { width: 25%; }
.selected-tab { background-color: rgb(177, 89, 38); color: rgb(255, 223, 89); }
.customization-panel {
    position: absolute;
    top: 64.5%;
    left: 4.5%;
    right: 4.5%;
    height: 30.5%;
    flex-direction: row;
    background-color: rgb(206, 239, 255);
    border-width: 8px;
    border-color: rgb(141, 204, 255);
    border-radius: 46px;
    padding: 38px 24px 44px 24px;
}
.categories {
    width: 31%;
    justify-content: space-around;
    align-items: center;
    margin-right: 2%;
}
.category { width: 94%; height: 13%; font-size: 36px; }
.selected-option { border-width: 7px; border-color: rgb(255, 178, 35); }
.options-panel {
    flex-grow: 1;
    background-color: rgb(147, 177, 199);
    border-radius: 32px;
    padding: 16px;
}
.mode-tabs { height: 15%; flex-direction: row; justify-content: space-between; }
.mode-tab { width: 46%; height: 100%; }
.selection-panel { flex-grow: 1; min-height: 0; padding-top: 24px; }
.style-options { flex-grow: 1; }
.style-options .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; }
.is-hidden { display: none; }
.color-controls { flex-direction: row; align-items: center; justify-content: space-between; }
.hue-wheel {
    width: 76%;
    height: 100%;
    background-image: url("project://database/Assets/AttemptUIWithAI/Textures/HueWheel.png");
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}
.color-swatch { width: 44%; height: 44%; border-radius: 200px; background-color: rgb(255, 72, 20); }
.handle { width: 46px; height: 46px; border-radius: 30px; border-width: 8px; border-color: white; background-color: rgb(255, 72, 20); }
.hue-handle { position: absolute; left: 6%; top: 22%; }
.gradient { width: 6%; height: 92%; border-radius: 30px; -unity-background-scale-mode: stretch-to-fill; }
.saturation { background-image: url("project://database/Assets/AttemptUIWithAI/Textures/Saturation.png"); }
.value { background-image: url("project://database/Assets/AttemptUIWithAI/Textures/Value.png"); margin-right: 6px; }
.slider-handle { position: absolute; top: -7px; left: -7px; }
.runtime-picker .color-swatch { position: absolute; width: 100%; height: 100%; background-color: transparent; }
.runtime-picker .handle { display: none; }
.runtime-picker .gradient { background-image: none; }
.start-button { position: absolute; right: 7%; bottom: 1.2%; width: 24%; height: 2.8%; background-color: rgb(255, 178, 35); color: white; font-size: 38px; }
