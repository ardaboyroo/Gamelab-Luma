.avatar-creation {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: white;
    overflow: hidden;
    color: rgb(177, 89, 38);
    -unity-font-style: bold;
}
.header-wave {
    position: absolute;
    top: 0;
    width: 100%;
    height: 30%;
    background-image: url("project://database/Assets/AttemptUIWithAI/Textures/HeaderWave.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.title {
    position: absolute;
    top: 8%;
    width: 100%;
    height: 9%;
    font-size: 84px;
    -unity-text-align: middle-center;
    color: rgb(177, 89, 38);
}
.decorative-trails {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/AttemptUIWithAI/Textures/DecorativeTrails.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.avatar-preview {
    position: absolute;
    top: 24%;
    left: 19%;
    width: 62%;
    height: 32%;
    -unity-background-scale-mode: scale-to-fit;
}
.pill {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 30px;
    background-color: rgb(255, 223, 89);
    color: rgb(177, 89, 38);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.pill:hover { background-color: rgb(255, 232, 135); }
.pill:active { background-color: rgb(255, 190, 60); }
.main-tabs {
    position: absolute;
    top: 56%;
    left: 4.5%;
    right: 4.5%;
    height: 6.7%;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    background-color: rgb(255, 178, 35);
    border-radius: 44px;
}
.main-tab { flex-grow: 1; flex-basis: 0; height: 60%; margin: 0 10px; padding: 0 6px; font-size: 34px; white-space: nowrap; }
.clothes-tab { }
.selected-tab { background-color: rgb(177, 89, 38); color: rgb(255, 223, 89); }
.customization-panel {
    position: absolute;
    top: 64.5%;
    left: 4.5%;
    right: 4.5%;
    height: 30.5%;
    flex-direction: row;
    background-color: rgb(206, 239, 255);
    border-width: 8px;
    border-color: rgb(141, 204, 255);
    border-radius: 46px;
    padding: 22px 18px 22px 18px;
}
.categories {
    width: 35%;
    flex-shrink: 0;
    justify-content: space-around;
    align-items: stretch;
    margin-right: 14px;
}
.category { height: 66px; flex-shrink: 1; padding: 0 8px; font-size: 27px; white-space: nowrap; }
.selected-option { border-width: 7px; border-color: rgb(255, 178, 35); }
.options-panel {
    flex-grow: 1;
    background-color: rgb(147, 177, 199);
    border-radius: 32px;
    padding: 16px;
}
.mode-tabs { height: 62px; flex-shrink: 0; flex-direction: row; justify-content: space-between; }
.mode-tab { width: 48%; height: 100%; font-size: 32px; }
.selection-panel { flex-grow: 1; min-height: 0; padding-top: 14px; overflow: hidden; }
.style-options { flex-grow: 1; }
.style-options .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; }
.dynamic-button-grid { width: 100%; flex-shrink: 0; }
.dynamic-button-row { flex-direction: row; flex-shrink: 0; }
.dynamic-button-cell { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 6px; }
.dynamic-option-button { height: 80px; font-size: 30px; }
.is-hidden { display: none; }
.color-controls { flex-direction: row; align-items: center; justify-content: space-between; }
.hue-wheel {
    width: 76%;
    height: 100%;
    background-image: url("project://database/Assets/AttemptUIWithAI/Textures/HueWheel.png");
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}
.color-swatch { width: 44%; height: 44%; border-radius: 200px; background-color: rgb(255, 72, 20); }
.handle { width: 46px; height: 46px; border-radius: 30px; border-width: 8px; border-color: white; background-color: rgb(255, 72, 20); }
.hue-handle { position: absolute; left: 6%; top: 22%; }
.gradient { width: 6%; height: 92%; border-radius: 30px; -unity-background-scale-mode: stretch-to-fill; }
.saturation { background-image: url("project://database/Assets/AttemptUIWithAI/Textures/Saturation.png"); }
.value { background-image: url("project://database/Assets/AttemptUIWithAI/Textures/Value.png"); margin-right: 6px; }
.slider-handle { position: absolute; top: -7px; left: -7px; }
.runtime-picker .color-swatch { position: absolute; width: 100%; height: 100%; background-color: transparent; }
.runtime-picker .handle { display: none; }
.runtime-picker .gradient { background-image: none; }
.start-button { position: absolute; right: 5%; bottom: 1%; height: 3.2%; padding: 0 28px; background-color: rgb(255, 178, 35); color: rgb(99, 46, 16); font-size: 28px; white-space: nowrap; }
.category-hint { position: absolute; left: 5.5%; bottom: 1%; width: 48%; height: 3.2%; font-size: 21px; white-space: normal; -unity-text-align: middle-left; }
.avatar-option-grid { flex-direction: row; flex-wrap: wrap; width: 100%; }
.avatar-option-card { width: 30%; height: 140px; margin: 1.5%; padding: 5px; align-items: center; justify-content: center; border-radius: 18px; flex-shrink: 0; }
.option-preview { flex-grow: 1; width: 100%; min-height: 0; }
.face-option-preview { rotate: 90deg; width: 64px; height: 64px; flex-grow: 0; flex-shrink: 0; }
.face-option-preview.mouth-option-preview { rotate: -90deg; }
.option-label { font-size: 16px; white-space: normal; -unity-text-align: middle-center; flex-shrink: 0; }

/* ---------- preset colour swatches (AvatarColorPresets) ---------- */
.color-controls { padding-top: 72px; }
.color-controls.presets-mode { padding-top: 14px; }
.color-presets { display: none; flex-grow: 1; height: 100%; flex-direction: row; flex-wrap: wrap; align-content: flex-start; align-items: flex-start; justify-content: center; overflow: hidden; }
.presets-mode .color-presets { display: flex; }
.presets-mode .hue-wheel,
.presets-mode .gradient { display: none; }
.color-preset { width: 76px; height: 76px; margin: 7px; border-radius: 38px; border-width: 5px; border-color: white; transition-property: scale; transition-duration: 0.1s; }
.color-preset:active { scale: 0.9 0.9; }
.color-preset--selected { border-color: rgb(177, 89, 38); scale: 1.12 1.12; }
.color-preset--wheel { background-image: url("project://database/Assets/AttemptUIWithAI/Textures/ColorWheel_Icon.png"); -unity-background-scale-mode: scale-to-fit; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.presets-back-btn { position: absolute; left: 0; top: 8px; height: 56px; padding: 0 22px 0 12px; flex-direction: row; align-items: center; font-size: 28px; border-width: 4px; border-color: rgb(177, 89, 38); }
.presets-back-icon { width: 34px; height: 34px; margin-right: 8px; flex-shrink: 0; background-image: url("project://database/Assets/AttemptUIWithAI/Textures/Back_Arrow_Icon.png"); -unity-background-scale-mode: scale-to-fit; }
.presets-back-label { margin: 0; padding: 0; font-size: 28px; -unity-font-style: bold; color: rgb(177, 89, 38); }
