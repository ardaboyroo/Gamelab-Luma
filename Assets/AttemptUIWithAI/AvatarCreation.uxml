<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="AvatarCreation.uss" />
    <ui:VisualElement name="avatarCreation" class="avatar-creation">
        <ui:VisualElement class="header-wave" picking-mode="Ignore" />
        <ui:VisualElement class="decorative-trails" picking-mode="Ignore" />
        <ui:Label text="Avatar aanpassen" class="title" picking-mode="Ignore" />
        <ui:Image name="avatarPreview" class="avatar-preview" picking-mode="Ignore" />
        <ui:VisualElement name="mainTabs" class="main-tabs">
            <ui:Button name="bodyTab" text="Lichaam" class="pill main-tab" />
            <ui:Button name="faceTab" text="Gezicht" class="pill main-tab selected-tab" />
            <ui:Button name="clothesTab" text="Kleding" class="pill main-tab clothes-tab" />
        </ui:VisualElement>
        <ui:VisualElement name="customizationPanel" class="customization-panel">
            <ui:VisualElement name="faceCategories" class="categories">
                <ui:Button name="eyesButton" text="Ogen" class="pill category selected-option" />
                <ui:Button name="eyebrowsButton" text="Wenkbrauwen" class="pill category" />
                <ui:Button name="noseButton" text="Neus" class="pill category" />
                <ui:Button name="mouthButton" text="Mond" class="pill category" />
                <ui:Button name="hairButton" text="Haar" class="pill category" />
            </ui:VisualElement>
            <ui:VisualElement name="bodyCategories" class="categories is-hidden">
                <ui:Button name="skinButton" text="Huidskleur" class="pill category" />
            </ui:VisualElement>
            <ui:VisualElement name="clothesCategories" class="categories is-hidden">
                <ui:Button name="topButton" text="Bovenkleding" class="pill category" />
                <ui:Button name="pantsButton" text="Broeken" class="pill category" />
                <ui:Button name="shoesButton" text="Schoenen" class="pill category" />
            </ui:VisualElement>
            <ui:VisualElement name="optionsPanel" class="options-panel">
                <ui:VisualElement class="mode-tabs">
                    <ui:Button name="styleTab" text="Stijl" class="pill mode-tab" />
                    <ui:Button name="colorTab" text="Kleur" class="pill mode-tab selected-option" />
                </ui:VisualElement>
                <ui:VisualElement name="stylePanel" class="selection-panel is-hidden">
                    <ui:ScrollView name="eyesStylePanel" class="style-options" mode="Vertical" />
                    <ui:ScrollView name="eyebrowsStylePanel" class="style-options is-hidden" mode="Vertical" />
                    <ui:ScrollView name="noseStylePanel" class="style-options is-hidden" mode="Vertical" />
                    <ui:ScrollView name="mouthStylePanel" class="style-options is-hidden" mode="Vertical" />
                    <ui:ScrollView name="hairStylePanel" class="style-options is-hidden" mode="Vertical" />
                    <ui:ScrollView name="topStylePanel" class="style-options is-hidden" mode="Vertical" />
                    <ui:ScrollView name="pantsStylePanel" class="style-options is-hidden" mode="Vertical" />
                    <ui:ScrollView name="shoesStylePanel" class="style-options is-hidden" mode="Vertical" />
                </ui:VisualElement>
                <ui:VisualElement name="colorPanel" class="selection-panel color-controls">
                    <ui:VisualElement name="hueWheel" class="hue-wheel">
                        <ui:VisualElement name="colorSwatch" class="color-swatch" />
                        <ui:VisualElement name="hueHandle" class="handle hue-handle" />
                    </ui:VisualElement>
                    <ui:VisualElement name="saturationSlider" class="gradient saturation" tooltip="Verzadiging"><ui:VisualElement name="saturationHandle" class="handle slider-handle" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="brightnessSlider" class="gradient value" tooltip="Helderheid"><ui:VisualElement name="valueHandle" class="handle slider-handle" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="categoryHint" text="Kies een stijl of pas de kleur aan." class="category-hint" />
        <ui:Button name="done-btn" text="Opslaan en terug" class="pill start-button" />
    </ui:VisualElement>
</ui:UXML>
