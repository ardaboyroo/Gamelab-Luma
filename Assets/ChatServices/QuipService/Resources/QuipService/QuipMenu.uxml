<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="QuipMenu.uss" />
    <Style src="../../../EmojiService/Resources/EmojiService/EmojiPanel.uss" />
    <ui:VisualElement class="quip-overlay">
        <ui:VisualElement class="quip-card">
            <ui:Label text="Berichten" class="quip-title" />
            <ui:VisualElement class="message-tabs">
                <ui:Button name="quips-tab" text="Berichten" class="message-tab" />
                <ui:Button name="emojis-tab" text="Emoji's" class="message-tab" />
            </ui:VisualElement>
            <ui:VisualElement name="quips-panel" class="message-panel">
                <ui:Label text="Kies een bericht om te versturen." class="quip-description" />
                <ui:ScrollView name="quip-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="quip-list" />
                <ui:Label name="quip-empty" text="Er zijn nog geen berichten beschikbaar." class="quip-empty" />
            </ui:VisualElement>
            <ui:VisualElement name="emoji-panel" class="message-panel" />
            <ui:Button name="quip-back-btn" text="Terug naar spel" class="quip-back" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
