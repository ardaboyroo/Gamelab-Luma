<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Button text="&#10;" name="menu-btn" style="width: 200px; font-size: 24%; border-bottom-left-radius: 43px; border-bottom-right-radius: 43px; border-top-right-radius: 43px; border-top-left-radius: 43px; border-left-width: 5px; border-right-width: 5px; border-top-width: 5px; border-bottom-width: 5px; border-left-color: rgb(112, 74, 52); border-right-color: rgb(112, 74, 52); border-top-color: rgb(112, 74, 52); border-bottom-color: rgb(112, 74, 52); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; background-color: rgb(248, 175, 44); height: 86px; background-image: resource(&apos;Sprites/Menu_Button&apos;); -unity-background-scale-mode: scale-to-fit; bottom: 20px; right: 20px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; position: absolute;" />
    <ui:VisualElement style="flex-grow: 1; position: absolute; height: 250px; width: 250px; top: auto; left: 0; background-color: rgb(248, 175, 44); border-top-right-radius: 180px; border-bottom-right-radius: 0; justify-content: center; align-self: flex-end; align-items: stretch; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; bottom: 0;">
        <ui:Button name="SkateboardButton" style="height: 100%; border-top-left-radius: 565px; border-top-right-radius: 565px; border-bottom-right-radius: 565px; border-bottom-left-radius: 565px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 24px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgb(177, 89, 38); width: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-image: resource(&apos;Sprites/skateboard&apos;); margin-top: 26px; margin-right: 26px; margin-bottom: 26px; margin-left: 26px; background-repeat: no-repeat no-repeat; -unity-background-scale-mode: scale-to-fit;" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
